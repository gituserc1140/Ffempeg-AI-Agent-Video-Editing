      "voice": [
        0.25,
        3.17
      ],
      "line": "Wood PLA versus metal-fill PLA. Who wins?"
    },
    {
      "id": "look",
      "start": 3.37,
      "end": 7.47,
      "voice": [
        3.62,
        7.27
      ],
      "line": "Looks. Wood is warm and matte, metal is shiny and cool."
    },
    {
      "id": "printing",
      "start": 7.47,
      "end": 11.5,
      "voice": [
        7.72,
        11.3
      ],
      "line": "Printing. Wood can clog. Metal wears nozzles, so go hardened."
    },
    {
      "id": "finishing",
      "start": 11.5,
      "end": 15.46,
      "voice": [
        11.75,
        15.26
      ],
      "line": "Finishing. Wood sands and stains. Metal polishes to a shine."
    },
    {
      "id": "weight",
      "start": 15.46,
      "end": 19.65,
      "voice": [
        15.71,
        19.45
      ],
      "line": "Weight. Metal's heavy, wood's light. Wood decor, metal trophies."
    },
    {
      "id": "verdict",
      "start": 19.65,
      "end": 26.07,
      "voice": [
        19.8,
        24.88
      ],
      "line": "It depends: warmth, wood. Weight and shine, metal. Follow for more filament battles!"
    }
  ],
